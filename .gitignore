.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Environment and local config
.env
.env.*
!.env.example
*.local
*.kubeconfig
kubeconfig

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
Dockerfile.cross

# Go build, test, and coverage output
*.test
*.out
coverage.out
coverage.html
*.coverprofile
*.prof
*.pprof
dist/

# Go workspace and dependency caches
go.work
go.work.sum
vendor/

# Kubernetes and Kubebuilder local artifacts
config/manager/manager.yaml.tmp
.kubebuilder/
files/

# Generated installer/report artifacts
install.yaml
mirops-report.json
report.json

# Logs
*.log

# Compatibility matrix — fetched from the mirops-compat OCI artifact at build time (CI), embedded via
# go:embed. Never committed; see CONTRIBUTING.md for building locally.
internal/compat/matrix.yaml

# CRDs — generated by `make manifests` and embedded via go:embed so the operator installs its own
# CRDs at startup. Copies of config/crd/bases; never committed.
internal/crd/*.yaml
