# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include go:embed'd data files (embedded at build time)
!internal/compat/matrix.yaml
# The operator embeds its own CRDs (installed at startup); they must reach the build context.
!internal/crd/*.yaml
